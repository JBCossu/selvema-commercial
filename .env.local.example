# ─── Base de données — Neon PostgreSQL (https://neon.tech) ───────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── API Anthropic (https://console.anthropic.com) ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# ─── Resend (https://resend.com) ───────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
# Adresse d'envoi vérifiée dans Resend. À défaut, onboarding@resend.dev (test uniquement).
RESEND_FROM_EMAIL=Selvema <onboarding@resend.dev>

# ─── Mot de passe administrateur (accès au back-office : /dashboard, /client…) ──
ADMIN_PASSWORD=change-me

# ─── Secret pour l'endpoint de relances automatiques /api/cron/relances ────────
CRON_SECRET=change-me-too

# ─── URL publique de ce déploiement (widget + liens des emails) ───────────────
NEXT_PUBLIC_APP_URL=http://localhost:3002
